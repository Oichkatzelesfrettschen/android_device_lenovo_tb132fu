android_app {
    name: "PurePixelWallpaper",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "31",
    product_specific: true,
    optimize: {
        enabled: true,
    },
}
