# TB132FU normally remains in its bootloader-owned static charging screen, but
# retain Android's standard charger service as a safe fallback for low-battery
# and alternate cable paths. It can automatically continue normal boot only
# once the configured minimum battery level is available.
service charger /system/bin/charger
    class charger
    user system
    group system wakelock input
    capabilities SYS_BOOT

# Keep downloaded packages and the uncrypt handoff on the partitions available
# to this cacheless non-A/B device. Recovery mounts metadata at /cache.
on post-fs-data
    mkdir /data/purepixel_updates 0770 system cache encryption=Require
    restorecon_recursive /data/purepixel_updates
    mkdir /metadata/ota/purepixel 0770 system cache
    restorecon_recursive /metadata/ota/purepixel
    mkdir /metadata/recovery 0770 system cache
    restorecon_recursive /metadata/recovery

# Keep the Goodix gesture engine in sync with the native device setting. The
# persistent property is replayed by init after /data is mounted, and each
# setting change retriggers exactly one of these actions.
on property:persist.sys.tb132fu.dt2w=1
    write /proc/gesture_control 1

on property:persist.sys.tb132fu.dt2w=0
    write /proc/gesture_control 0

# The retained Goodix driver keeps active-pen scanning disabled until userspace
# opts in through this device node. The old TrebleDroid compatibility script
# performed this write globally; native TB132FU owns it explicitly. Waiting for
# boot completion guarantees the asynchronous Goodix stage-2 probe has created
# the node, and the driver then restores pen mode after every doze resume.
on property:sys.boot_completed=1
    write /sys/devices/platform/goodix_ts.0/support_pen 1
