<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="doze_display_state_supported">true</bool>
    <bool name="doze_suspend_display_state_supported">true</bool>
    <bool name="doze_suspend_display_state_needs_time_tick_refresh">true</bool>
    <bool name="doze_proximity_check_before_pulse">false</bool>
    <!-- The panel has native 60 and 120 Hz modes. Continuous AOD consumes
         materially less power at 60 Hz while normal display policy remains
         under the user's refresh-rate preference. -->
    <integer name="config_keyguardMaxRefreshRate">60</integer>
    <!-- The panel reports a portrait natural orientation, where the chassis power button is on
         the top edge near the right corner. ROTATION_90 maps it to the upper-left screen edge in
         the tablet's normal landscape posture. -->
    <integer name="physical_power_button_screen_edge">0</integer>
    <dimen name="physical_power_button_center_screen_location_y">1220px</dimen>
</resources>
