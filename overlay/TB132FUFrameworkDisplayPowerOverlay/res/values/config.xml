<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pixel uses a circular adaptive-icon mask. AOSP's framework default is
         a rounded square, which also affects the Settings icon surfaces. -->
    <string name="config_icon_mask" translatable="false">M50 0A50 50,0,1,1,50 100A50 50,0,1,1,50 0</string>

    <!-- Use the event-driven Pure Pixel wallpaper for clean installs and new
         users. It follows UI night mode without a timer or animation. -->
    <string name="default_wallpaper_component" translatable="false">org.purepixel.wallpaper/.PurePixelWallpaperService</string>

    <!-- The RM692H0-family OLED panel and vendor display stack accept
         DOZE_SUSPEND, but the panel retains its last scanned-out buffer there.
         The TB132FU SystemUI overlay opts into a narrow minute-tick refresh
         through ordinary DOZE. Keep AOD available but default it off until
         that path passes physical power and panel qualification: RC3 measured
         0% CPU deep sleep in DOZE versus 94.66% with the panel fully off. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <bool name="config_dozeSupportsAodWallpaper">false</bool>
    <!-- SystemUI already shifts and scales AOD content on this device. Keep
         the optional whole-framebuffer shifter off to avoid double shifting
         and clipping the tablet UI. -->
    <bool name="config_enableBurnInProtection">false</bool>
    <bool name="config_displayBlanksAfterDoze">false</bool>
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <integer name="config_screenBrightnessDoze">1</integer>
    <bool name="config_displayBrightnessBucketsInDoze">false</bool>

    <!-- Restore the factory TB132FU/LGSI display calibration that was supplied
         by the stock product overlay. The retained MediaTek vendor overlay
         advertises automatic brightness, but the native AOSP product no longer
         carries these mappings; without them Android sees the working ltr569_l
         light sensor yet falls back to manual brightness with an empty curve. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>60</item>
        <item>210</item>
        <item>350</item>
        <item>420</item>
        <item>1000</item>
    </integer-array>
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>40</item>
        <item>40</item>
        <item>100</item>
        <item>150</item>
        <item>300</item>
        <item>420</item>
        <item>490</item>
    </array>
    <array name="config_screenBrightnessBacklight">
        <item>0</item>
        <item>32</item>
        <item>51</item>
        <item>77</item>
        <item>153</item>
        <item>214</item>
        <item>255</item>
    </array>
    <array name="config_screenBrightnessNits">
        <item>0</item>
        <item>40</item>
        <item>100</item>
        <item>150</item>
        <item>300</item>
        <item>420</item>
        <item>490</item>
    </array>

    <!-- The panel exposes physical 60 and 120 Hz modes. Keep the default
         render vote wide enough to admit 120 Hz; Android 17 intersects this
         vote with the user's peak setting before SurfaceFlinger can apply its
         touch/content policy. A 60 Hz default here silently capped Fluid mode
         at 60 Hz even though peak_refresh_rate was 120. Content detection may
         still select 60 Hz while idle, Standard clamps the peak to 60 Hz, and
         Force 120 raises the minimum to 120 Hz. -->
    <integer name="config_defaultRefreshRate">120</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- Lenovo's stock product overlay enables the display-wide hardware color
         transform. AOSP uses this capability to expose Night Light and Extra
         Dim through ColorDisplayService. -->
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- ColorDisplayService accepts only the modes listed here. Natural (0) is
         SurfaceFlinger's managed sRGB mode and, as the first entry, the default;
         saturated (2) leaves the panel on its own gamut. -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>2</item>
    </integer-array>

    <!-- Android 17 desktop-first mode switches the internal display to desktop
         windowing only while the pogo keyboard and touchpad are both active. -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>
    <bool name="config_enterDesktopByDefaultOnFreeformDisplay">true</bool>
    <bool name="config_showHomeBehindDesktop">true</bool>
</resources>
